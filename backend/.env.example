# Local development
PORT=3000
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/SecondBrain

# Auth
JWT_SECRET=change-this-to-a-long-random-secret
SESSION_EXPIRY=30m

# Google OAuth — set the SAME client ID in frontend/.env as VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=

# Demo user
DEMO_USER_ENABLED=true
DEMO_USER_USERNAME=demo
DEMO_USER_PASSWORD=demo12345

# ── Render production (set in Render dashboard) ──
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/SecondBrain?retryWrites=true&w=majority
# JWT_SECRET=<long-random-string>
# FRONTEND_URL=https://your-frontend.onrender.com
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# DEMO_USER_ENABLED=false
